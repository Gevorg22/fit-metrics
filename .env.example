# ─── База данных (Neon / Vercel Postgres) ────────────────────────────────────
# Pooled connection — используется Prisma в рантайме
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.region.aws.neon.tech/DATABASE?sslmode=require"

# Direct connection — используется для prisma migrate / prisma db push
DIRECT_URL="postgresql://USER:PASSWORD@HOST.region.aws.neon.tech/DATABASE?sslmode=require"

# ─── Auth.js (NextAuth v5) ────────────────────────────────────────────────────
# Генерируется командой: openssl rand -base64 32
AUTH_SECRET="your-auth-secret-here"

# URL приложения (без слеша в конце)
NEXTAUTH_URL="http://localhost:3000"

# ─── Resend (Magic Link Email) ────────────────────────────────────────────────
# Получить на https://resend.com → API Keys
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# Email-адрес отправителя (должен быть верифицирован в Resend)
EMAIL_FROM="fitMetrics <noreply@yourdomain.com>"

# ─── Telegram-бот ─────────────────────────────────────────────────────────────
# Токен от @BotFather
TELEGRAM_BOT_TOKEN="1234567890:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA"
# Числовой ID бота (часть токена до двоеточия)
NEXT_PUBLIC_TELEGRAM_BOT_ID="1234567890"

# ─── Web Push (VAPID) ─────────────────────────────────────────────────────────
# Генерируется командой: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY="BXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
VAPID_PRIVATE_KEY="XXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
VAPID_EMAIL="mailto:you@example.com"

# ─── Groq (AI-советник и недельный отчёт) ─────────────────────────────────────
# Получить на https://console.groq.com → API Keys
GROQ_API_KEY="gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"

# ─── Cron ─────────────────────────────────────────────────────────────────────
# Обязателен: без него /api/push/send и /api/cron/workout-reminder отдают 403.
# Тот же самый секрет положить в GitHub → Settings → Secrets → Actions
# Генерируется командой: openssl rand -hex 32
CRON_SECRET="your-cron-secret-here"
